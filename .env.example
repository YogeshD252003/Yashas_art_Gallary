# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret key for signing JSON Web Tokens.
JWT_SECRET="YOUR_JWT_SECRET_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Options (Optional, falls back to serviceAccountKey.json and firebase-applet-config.json)
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_STORAGE_BUCKET="your-firebase-project-id.firebasestorage.app"
# FIREBASE_DATABASE_ID="(default)" # Use "(default)" or your specific Firestore Database ID
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

