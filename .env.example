# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret key for signing JSON Web Tokens.
JWT_SECRET="YOUR_JWT_SECRET_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Options (Optional, falls back to serviceAccountKey.json and firebase-applet-config.json)
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_STORAGE_BUCKET="your-firebase-project-id.firebasestorage.app"
# FIREBASE_DATABASE_ID="(default)" # Use "(default)" or your specific Firestore Database ID
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'

# WhatsApp: every admin in Firestore `admins` collection with a `phone` field receives order alerts.
# ADMIN_WHATSAPP_NUMBER is only used if no admin phones exist in the database.
# ADMIN_WHATSAPP_NUMBER="919900910536"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Frontend: fallback for manual WhatsApp share button in admin panel
# VITE_ADMIN_WHATSAPP="919900910536"

# EmailJS — admin email when a customer places an order (https://www.emailjs.com)
# Copy email-templates/admin-order.html into EmailJS dashboard as your template.
# Admin inbox is auto-loaded from Firestore `admins` collection; ADMIN_EMAIL is fallback.
# ADMIN_EMAIL="yogeshd252003@gmail.com"
# EMAILJS_SERVICE_ID="your_service_id"
# EMAILJS_TEMPLATE_ID="your_template_id"
# EMAILJS_PUBLIC_KEY="your_public_key"
# EMAILJS_PRIVATE_KEY=""  # optional, for server-only sends
# VITE_ADMIN_EMAIL="yogeshd252003@gmail.com"
# VITE_EMAILJS_SERVICE_ID="your_service_id"
# VITE_EMAILJS_TEMPLATE_ID="your_template_id"
# VITE_EMAILJS_PUBLIC_KEY="your_public_key"

